PORT=3006
NODE_ENV=development
# Local MySQL / HeidiSQL. Create an empty database named inventra first.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=inventra
DB_USER=root
DB_PASSWORD=
# Or set DATABASE_URL to a PostgreSQL TLS URL (Neon). Never commit a real URL.
# DATABASE_URL=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrador
ADMIN_PASSWORD=change-this-before-starting
SEED_DEMO=true
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
